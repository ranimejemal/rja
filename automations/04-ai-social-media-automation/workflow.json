      "id": "node-0085",
      "name": "Write posts with AI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        600,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "function readAiJson(response) {\n  const content = response && response.choices && response.choices[0] && response.choices[0].message && response.choices[0].message.content;\n  if (!content) throw new Error(\"OpenAI returned no answer: \" + JSON.stringify(response).slice(0, 300));\n  try {\n    return JSON.parse(content);\n  } catch {\n    throw new Error(\"OpenAI answer was not valid JSON: \" + content.slice(0, 300));\n  }\n}\n\nconst rows = $('Posts to write').all();\nreturn $input.all().map((item, i) => {\n  const row = rows[i].json;\n  const ai = readAiJson(item.json);\n  return { json: { post_id: row.post_id, status: 'waiting approval', instagram: ai.instagram || '', facebook: ai.facebook || '',\n    linkedin: ai.linkedin || '', x: ai.x || '', hashtags: ai.hashtags || '', topic: row.topic, publish_at: row.publish_at }, pairedItem: { item: i } };\n});"
      },
