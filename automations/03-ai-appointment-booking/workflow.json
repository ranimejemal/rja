{
  "name": "AI Appointment Booking | Ranime Jemal Agency",
  "nodes": [
    {
      "parameters": {
        "content": "## AI Appointment Booking\n1. Fill in **Settings** (calendar ID: Google Calendar > Settings > Integrate calendar).\n2. Connect OpenAI, Google Calendar and Gmail.\n3. Activate. Share the chat URL from the **Chat** node, or embed it on your site.\nReminders are emailed every hour for appointments starting in 24 hours.",
        "height": 260,
        "width": 520,
        "color": 4
      },
      "id": "node-004f",
      "name": "Note 1",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -560,
        -420
      ]
    },
    {
      "parameters": {
        "public": true,
        "mode": "hostedChat",
        "initialMessages": "Hi! I can book, move or cancel an appointment for you. What would you like to do?",
        "options": {
          "title": "Book an appointment",
          "subtitle": "Pick a time that suits you.",
          "inputPlaceholder": "Type your message...",
          "showWelcomeScreen": false
        }
      },
      "id": "node-0051",
      "name": "Chat",
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.1,
      "position": [
        -560,
        0
      ],
