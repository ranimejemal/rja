        "eventId": "={{ $fromAI('event_id', 'The event ID of the appointment to cancel', 'string') }}",
        "options": {
          "sendUpdates": "all"
        }
      },
      "id": "node-006a",
      "name": "cancel_booking",
      "type": "n8n-nodes-base.googleCalendarTool",
      "typeVersion": 1.3,
      "position": [
        940,
        140
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "calendar": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Settings').first().json.calendarId }}"
        },
        "returnAll": true,
        "timeMin": "={{ $now.plus({ hours: $('Settings').first().json.reminderHoursBefore }).toISO() }}",
        "timeMax": "={{ $now.plus({ hours: $('Settings').first().json.reminderHoursBefore + 1 }).toISO() }}",
        "options": {
          "singleEvents": true
        }
      },
      "id": "node-006b",
      "name": "Upcoming appointments",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        200,
        460
      ]
    },
    {
      "parameters": {
        "jsCode": "function dueReminders(events, nowIso, hoursBefore) {\n  const now = Date.parse(nowIso);\n  const from = now + hoursBefore * 3600000;\n  const to = from + 3600000;\n  const out = [];\n  for (const e of events) {\n    const start = Date.parse((e.start && (e.start.dateTime || e.start.date)) || \"\");\n    if (!Number.isFinite(start) || start < from || start >= to || e.status === \"cancelled\") continue;\n    const attendee = (e.attendees || []).find((a) => a.email && !a.self && !a.organizer);\n    const fromDescription = String(e.description || \"\").match(/[^\\s<>\"]+@[^\\s<>\"]+\\.[a-z]{2,}/i);\n    const email = attendee ? attendee.email : fromDescription ? fromDescription[0] : \"\";\n    if (email) out.push({ event_id: e.id, summary: e.summary || \"Appointment\", start: new Date(start).toISOString(), email });\n  }\n  return out;\n}\n\nconst s = $('Settings').first().json;\nconst input = $input.all();\nconst events = input.map((i) => i.json).filter((e) => e.id);\nconst index = new Map(input.map((it, i) => [it.json.id, i]));\nreturn dueReminders(events, new Date().toISOString(), Number(s.reminderHoursBefore)).map((r) => ({ json: {\n  ...r,\n  when: DateTime.fromISO(r.start).setZone(s.timezone).toFormat(\"cccc d LLLL 'at' HH:mm\"),\n}, pairedItem: { item: index.get(r.event_id) } }));"
      },
      "id": "node-006c",
      "name": "Reminders to send",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        460
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "=Reminder: your appointment at {{ $('Settings').first().json.businessName }}",
        "emailType": "text",
        "message": "=Hello,\n\nThis is a reminder of your appointment ({{ $json.summary }}) on {{ $json.when }} at {{ $('Settings').first().json.address }}.\n\nIf you need to change it, just reply to this email.\n\nSee you soon,\n{{ $('Settings').first().json.senderName }}",
        "options": {
          "appendAttribution": false,
          "senderName": "={{ $('Settings').first().json.senderName }}"
        }
      },
      "id": "node-006d",
      "name": "Send reminder",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        640,
        460
      ]
    }
