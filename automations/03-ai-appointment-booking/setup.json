{
  "schemaVersion": 1,
  "productType": "n8n-workflow",
  "workflowVersion": "1.0.0",
  "settings": [
    {
      "key": "ai_provider",
      "label": "Which AI do you want to use?",
      "type": "select",
      "required": true,
      "default": "gemini",
      "help": "Google Gemini is free (a free key from Google, no card). Choose OpenAI if you already pay for ChatGPT's API: a little more reliable at busy hours.",
      "options": [
        {
          "value": "gemini",
          "label": "Google Gemini: free"
        },
        {
          "value": "openai",
          "label": "OpenAI (ChatGPT): my own paid key"
        }
      ]
    },
    {
      "key": "business_name",
      "label": "Business name",
      "help": "As your customers know it. Example: Ranime Jemal Agency",
      "type": "text",
      "required": true,
      "maxLength": 300
    },
    {
      "key": "services",
      "label": "Your services and their length",
      "help": "Separated by commas. Example: Haircut (45 min), Colour (90 min), Consultation (30 min)",
      "type": "textarea",
      "required": true,
      "maxLength": 2000
    },
    {
      "key": "address",
      "label": "Address",
      "help": "Given to customers when they book.",
      "type": "text",
      "required": true,
      "maxLength": 300
    },
    {
      "key": "calendar_id",
      "label": "Google Calendar to use",
      "help": "Leave \"primary\" to use your main calendar. For another calendar: Google Calendar, Settings, the calendar, Integrate calendar, Calendar ID.",
      "type": "text",
      "required": true,
      "maxLength": 300,
      "default": "primary"
    },
    {
      "key": "timezone",
      "label": "Time zone",
      "help": "Example: Africa/Tunis, Europe/Paris, Europe/London, America/New_York",
      "type": "text",
      "required": true,
      "maxLength": 300,
      "default": "Europe/Paris"
    },
    {
      "key": "open_days",
      "label": "Open days",
      "help": "Example: Monday to Saturday",
      "type": "text",
      "required": true,
      "maxLength": 300,
      "default": "Monday to Saturday"
    },
    {
      "key": "open_time",
      "label": "Opening time",
      "help": "24-hour format. Example: 09:00",
      "type": "text",
      "required": true,
      "maxLength": 300,
      "default": "09:00"
    },
    {
      "key": "close_time",
      "label": "Closing time",
      "help": "24-hour format. Example: 18:00",
      "type": "text",
      "required": true,
      "maxLength": 300,
      "default": "18:00"
    },
    {
      "key": "slot_minutes",
      "label": "Length of an appointment (minutes)",
      "help": "Example: 30 or 60",
      "type": "number",
      "required": false,
      "min": 5,
      "max": 480,
      "default": 60
    },
    {
      "key": "reminder_hours_before",
      "label": "Send the reminder this many hours before",
      "help": "24 means the day before.",
      "type": "number",
      "required": false,
      "min": 1,
      "max": 168,
      "default": 24
    },
    {
      "key": "sender_name",
      "label": "Sender name on emails",
      "help": "The name people see in their inbox. Example: Sarah from Maison Lina",
      "type": "text",
      "required": true,
      "maxLength": 300
    }
  ]
}
